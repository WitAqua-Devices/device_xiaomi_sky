<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.felica"
    android:versionCode="1"
    android:versionName="1.0"
    android:sharedUserId="android.uid.system">

    <application
        android:label="@string/app_name">

        <activity
            android:name=".FelicaSettingsActivity"
            android:exported="false"
            android:label="@string/felica_setting_header"
            android:theme="@style/Theme.SubSettingsBase.Expressive">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.device" />
            <!-- A dynamic tile is offset by the order of the screen's
                 dashboard_tile_placeholder, which connected_devices_advanced.xml
                 puts at -8, so this lands on -7: the same order as the NFC
                 entry. Preferences that tie on order sort by title, and both
                 "Osaifu-Keitai" and "おサイフケータイ" come after "NFC", so the
                 entry sits directly below it. A tile with no order at all keeps
                 Preference.DEFAULT_ORDER and falls to the bottom of the screen. -->
            <meta-data
                android:name="com.android.settings.order"
                android:value="1" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_felica" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/felica_setting_summary" />
        </activity>

    </application>
</manifest>
